# Optional configuration, read by scripts/Start-Tuerwache.ps1 and start-linux.sh.
# Never commit the real .env. Keep external access off until HTTPS + MFA are ready.
HOST=127.0.0.1
PORT=3210
# AI_PYTHON=/opt/tuerwache/.venv/bin/python
# PUBLIC_ORIGIN=https://cameras.example.com
# ALLOWED_HOSTS=cameras.example.com
# TRUSTED_PROXY_IPS=127.0.0.1
# AUTH_ENCRYPTION_KEY=<64 random hex characters, keep outside data backups>

# Optional absolute directories (keep outside public web files)
# DATA_DIRECTORY=/opt/tuerwache/data
# BACKUP_DIRECTORY=/opt/tuerwache/backups/snapshots

# Optional private SFace worker. Configure the same random token on both systems.
# FACE_WORKER_URL=https://ki.home.arpa:3211
# FACE_WORKER_TOKEN=<64 random hex characters>
# Worker server settings (scripts/start-face-worker.mjs)
# FACE_WORKER_HOST=127.0.0.1
# FACE_WORKER_PORT=3211
# FACE_WORKER_CERT=/path/to/cert.pem
# FACE_WORKER_KEY=/path/to/key.pem
# On the camera server only, opt in to ArcFace enrolment and the per-camera ArcFace engine:
# FACE_WORKER_ARCFACE=1
# On the separate worker only, point to the supported model (see the Raspberry Pi guide):
# FACE_WORKER_ARCFACE_MODEL=/path/to/w600k_r50.onnx
